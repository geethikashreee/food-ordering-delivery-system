# Copy to .env.local and fill in the same MySQL Server details used in Workbench.
# Never commit .env.local or paste your real database password into chat.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=food_db
# Hosted MySQL normally requires TLS. Use the provider's required SSL setting.
MYSQL_SSL=true
# Optional: an absolute CA certificate path, or a certificate value with escaped newlines.
MYSQL_SSL_CA_FILE=
MYSQL_SSL_CA=
# Set this to your public HTTPS URL when deploying.
APP_URL=http://127.0.0.1:3000

# Comma-separated Foodly account emails allowed to open Admin Orders.
FOODLY_ADMIN_EMAILS=
